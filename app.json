{
  "expo": {
    "name": "Eat Me",
    "slug": "eatme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_01.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vignesh12.eatmeapp",
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash/ios/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.vignesh12.eatmeapp"
    },
    "scheme": "eat-me-app",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "75643b3d-434c-4209-b903-441974b0960f"
      }
    },
    "owner": "vignesh12k",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash/ios/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}

{
  "expo": {
    "name": "Eat Me",
    "slug": "eatme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vignesh12.eatmeapp",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Eat Me uses your location to set your delivery address and show nearby options."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundColor": "#FF6C44"
      },
      "package": "com.vignesh12.eatmeapp"
    },
    "scheme": "eat-me-app",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "75643b3d-434c-4209-b903-441974b0960f"
      }
    },
    "owner": "vignesh12k",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 240
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eat Me uses your location to set your delivery address and show nearby options."
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker",
      "react-native-maps"
    ]
  }
}
